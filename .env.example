AIOPENSTUDIO_ENVIRONMENT=development
AIOPENSTUDIO_LOG_LEVEL=INFO
AIOPENSTUDIO_OLLAMA_BASE_URL=http://localhost:11434
# Rutas relativas a la raíz del proyecto durante desarrollo.
AIOPENSTUDIO_DATA_DIR=data
AIOPENSTUDIO_MANIFESTS_DIR=models
AIOPENSTUDIO_CACHE_DIR=data/cache
AIOPENSTUDIO_INPUT_DIR=data/inputs
AIOPENSTUDIO_OUTPUT_DIR=data/outputs
AIOPENSTUDIO_LOG_DIR=data/logs
AIOPENSTUDIO_SQLITE_PATH=data/runtime/memory.sqlite3
AIOPENSTUDIO_SQLITE_ENABLE_VECTORS=false
AIOPENSTUDIO_SQLITE_BUSY_TIMEOUT_MS=5000
# Biblioteca compartida: solo la raíz depende del computador; sus hijos son relativos.
AIOPENSTUDIO_MODEL_LIBRARY_ROOT=C:/path/to/AIModels
AIOPENSTUDIO_MODEL_CATALOG_PATH=catalog/model-library.sqlite3
AIOPENSTUDIO_OLLAMA_MODELS_DIR=ollama
AIOPENSTUDIO_HUGGINGFACE_HOME=huggingface
AIOPENSTUDIO_WHISPER_MODELS_DIR=whisper
AIOPENSTUDIO_FOOOCUS_MODELS_DIR=fooocus
AIOPENSTUDIO_EMBEDDING_MODELS_DIR=embeddings
AIOPENSTUDIO_MODEL_MANIFESTS_DIR=manifests
AIOPENSTUDIO_MODEL_CACHE_DIR=cache
AIOPENSTUDIO_MODEL_TEMP_DIR=temp
AIOPENSTUDIO_MODEL_CHECKLIST_PATH=download-checklist.md
AIOPENSTUDIO_WEIGHTS_DIR=C:/path/to/AIModels
# Variables consumidas directamente por los runtimes y sus clientes.
OLLAMA_MODELS=C:/path/to/AIModels/ollama
HF_HOME=C:/path/to/AIModels/huggingface
# Opcional. Dejar vacío para ejecutar sin PostgreSQL.
AIOPENSTUDIO_DATABASE_URL=
